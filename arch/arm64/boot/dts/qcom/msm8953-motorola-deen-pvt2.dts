/*
 * Motorola One Deen PVT2 board candidate.
 * Board ID is retained from the clean Motorola 4.19 donor.
 *
 * Do not select for the handset until its board revision is independently
 * identified from the stock DTB/bootloader data.
 */

/dts-v1/;

#include "msm8953-motorola-deen-common.dtsi"

/ {
	model = "Motorola One (Deen PVT2)";
	compatible = "motorola,deen", "qcom,msm8953";
	qcom,board-id = <0x4D 0xC200>;
};
