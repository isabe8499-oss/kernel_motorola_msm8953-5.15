/*
 * Motorola One Deen PVT1 board candidate.
 * Root identity and board tuple were checked against the supplied stock boot_b.
 * The rest of this candidate DTS is not yet proven equivalent to stock hardware.
 */

/dts-v1/;

#include "msm8953-motorola-deen-common.dtsi"

/ {
	model = "deen";
	compatible = "qcom,msm8953-deen", "qcom,msm8953-moto", "qcom,msm8953";
	qcom,msm-id = <0x125 0>;
	qcom,board-id = <0x4D 0xC100>;
};
